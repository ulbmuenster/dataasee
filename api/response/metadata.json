{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "dataasee:api?response=metadata",

  "title": "DatAasee Metadata Endpoint Response", "description": "The metadata endpoint returns either a list of abbreviated records, a list of full records, a single record, a single record in datacite format, or a single record in BibJSON format.",

  "type": "object", "oneOf": [ { "required": ["data", "meta", "links"] },

                               { "required": ["errors", "meta", "links"] } ], "properties": {

    "data": { "oneOf": [

      { "type": "array", "title": "Result", "maxItems": 100,

          "items":  { "type": "object", "required": ["type", "id", "attributes"], "properties": {

            "type": { "type": "string", "const": "data" },

            "id": { "type": "string", "description": "Record Identifier", "pattern": "^ni:.*" },

            "attributes": { "oneOf": [

              { "type": "object", "title": "Search Results", "required": ["recordId", "metadataQuality", "title",
                                                                          "publicationYear", "resourceType", "doi"], "properties": {

                  "recordId": { "type": "string", "title": "Record Identifier", "pattern": "^ni:.*" },

                  "metadataQuality": { "type": "string", "title": "Metadata Quality" },

                  "title": { "type": ["string", "null"], "title": "Title" },

                  "publicationYear": { "type": ["integer", "null"], "title": "Publication Year" },

                  "resourceType": { "type": ["string", "null"], "title": "Resource Type" },

                  "doi" : { "type": ["string", "null"], "title": "Digital Object Identifier" } } },

              { "type": "object", "title": "List Results", "required": ["schemaVersion", "recordId", "metadataQuality",
                                                                        "dataSteward", "source", "createdAt",
                                                                        "title", "creators",
                                                                        "publisher", "publicationYear", "resourceType",
                                                                        "identifiers", "rawChecksum", "rawFormat",
                                                                        "related"], "properties": {

                  "schemaVersion": { "type": "integer", "title": "Schema Version" },

                  "recordId": { "type": "string", "title": "Record Identifier", "pattern": "^ni:.*" },

                  "metadataQuality": { "type": ["string", "null"], "title": "Metadata Quality" },

                  "dataSteward": { "type": "string", "title": "Data Steward" },

                  "source": { "type": "string", "title": "Source" },

                  "createdAt": { "type": "string", "title": "Created At" },

                  "sizeBytes": { "type": ["integer", "null"], "title": "Data Size (in Bytes)" },

                  "dataFormat": { "type": ["string", "null"], "title": "Data (File) Format" },

                  "dataLocation": { "type": ["string", "null"], "title": "Data Location", "format": "uri" },

                  "keywords": { "type": ["array", "null"], "title": "Keywords",

                    "items": { "type": "string", "title": "Keyword" } },

                  "categories": { "type": ["array", "null"], "title": "Categories",

                    "items": { "type": "string", "title": "Category" } },

                  "title": { "type": ["string", "null"], "title": "Title" },

                  "creators": { "type": ["array", "null"], "title": "Creators",

                    "items": { "type": "object", "required": ["name"], "properties": {

                      "name": { "type": "string", "title": "Display Name" },

                      "data": { "type": "string", "format": "uri", "title": "Persistent Identifier" } } } },

                  "publisher": { "type": ["string", "null"], "title": "Publisher" },

                  "publicationYear": { "type": ["integer", "null"], "title": "Published" },

                  "resourceType": { "type": ["string", "null"], "title": "Resource Type" },

                  "identifiers": { "type": ["array", "null"], "title": "Identifiers",

                    "items": { "type": "object", "required": ["name"], "properties": {

                      "name": { "type": "string", "title": "Persistent Identifier" },

                      "data": { "type": "string", "title": "Identifier Type" } } } },

                  "synonyms": { "type": "array", "title": "Synonyms",

                    "items": { "type": "object", "required": ["name"], "properties": {

                      "name": { "type": "string", "title": "Alternative Title" },

                      "data": { "type": "string", "title": "Title Type" } } } },

                  "language": { "type": ["string", "null"], "title": "Language" },

                  "subjects": { "type": "array", "title": "Subjects",

                    "items": { "type": "object", "properties": {

                      "name": { "type": "string", "title": "Subject Name" },

                      "data": { "type": "string", "format": "uri", "title": "Subject Identifier" } } } },

                  "version": { "type": "string", "title": "Version" },

                  "license": { "type": ["object", "null"], "required": ["name"], "properties": {

                    "name": { "type": "string", "title": "License" },

                    "data": { "type": "string", "format": "uri", "title": "Project Identifier" } } },

                  "rights": { "type": "string", "title": "Rights" },

                  "fundings": { "type": "array", "title": "Fundings",

                    "items": { "type": "object", "required": ["name"], "properties": {

                      "name": { "type": "string", "title": "Award Identifier" },

                      "data": { "type": "string", "title": "Funder Name" } } } },

                  "description": { "type": ["string", "null"], "title": "Description" },

                  "relatedItems": { "type": "array", "title": "Related Items",

                    "items": { "type": "object", "properties": {

                      "name": { "type": "string", "title": "Item Type" },

                      "data": { "type": "string", "format": "uri", "title": "Item Identifier" } } } },

                  "rawMetadata": { "type": "string", "title": "Raw Metadata" },

                  "rawFormat": { "type": "string", "title": "Metadata Format" },

                  "rawChecksum": { "type": ["string", "null"], "title": "Metadata Checksum (MD5)" },

                  "related": { "type": "object", "title": "internal relations",

                    "additionalProperties": { "type": "array", "title": "Relation Type",

                      "items": { "type": "string", "title": "Identifier" } } } } } ] } } } },

      { "type": "object", "title": "Fetch Result", "required": ["type", "id", "attributes"], "properties": {

          "type": { "type": "string", "const": "data" },

          "id": { "type": "string", "description": "Record Identifier", "pattern": "^ni:.*" },

          "attributes": {

            "type": "object", "title": "Payload", "required": ["schemaVersion", "recordId", "metadataQuality",
                                                               "dataSteward", "source", "createdAt",
                                                               "title", "creators",
                                                               "publisher", "publicationYear", "resourceType",
                                                               "identifiers", "rawChecksum", "rawFormat"], "properties": {

              "schemaVersion": { "type": "integer", "title": "Schema Version" },

              "recordId": { "type": "string", "title": "Record Identifier", "pattern": "^ni:.*" },

              "metadataQuality": { "type": ["string", "null"], "title": "Metadata Quality" },

              "dataSteward": { "type": "string", "title": "Data Steward" },

              "source": { "type": "string", "title": "Source" },

              "createdAt": { "type": "string", "title": "Created At" },

              "sizeBytes": { "type": ["integer", "null"], "title": "Data Size (in Bytes)" },

              "dataFormat": { "type": ["string", "null"], "title": "Data (File) Format" },

              "dataLocation": { "type": ["string", "null"], "title": "Data Location", "format": "uri" },

              "keywords": { "type": ["array", "null"], "title": "Keywords",

                "items": { "type": "string", "title": "Keyword" } },

              "categories": { "type": ["array", "null"], "title": "Categories",

                "items": { "type": "string", "title": "Category" } },

              "title": { "type": ["string", "null"], "title": "Title" },

              "creators": { "type": ["array", "null"], "title": "Creators",

                "items": { "type": "object", "required": ["name"], "properties": {

                  "name": { "type": "string", "title": "Display Name" },

                  "data": { "type": "string", "format": "uri", "title": "Persistent Identifier" } } } },

              "publisher": { "type": ["string", "null"], "title": "Publisher" },

              "publicationYear": { "type": ["integer", "null"], "title": "Published" },

              "resourceType": { "type": ["string", "null"], "title": "Resource Type" },

              "identifiers": { "type": ["array", "null"], "title": "Identifiers",

                "items": { "type": "object", "required": ["name"], "properties": {

                  "name": { "type": "string", "title": "Persistent Identifier" },

                  "data": { "type": "string", "title": "Identifier Type" } } } },

              "synonyms": { "type": "array", "title": "Synonyms",

                "items": { "type": "object", "required": ["name"], "properties": {

                  "name": { "type": "string", "title": "Alternative Title" },

                  "data": { "type": "string", "title": "Title Type" } } } },

              "language": { "type": ["string", "null"], "title": "Language" },

              "subjects": { "type": "array", "title": "Subjects",

                "items": { "type": "object", "properties": {

                  "name": { "type": "string", "title": "Subject Name" },

                  "data": { "type": "string", "format": "uri", "title": "Subject Identifier" } } } },

              "version": { "type": "string", "title": "Version" },

              "license": { "type": ["object", "null"], "required": ["name"], "properties": {

                "name": { "type": "string", "title": "License Identifier" },

                "data": { "type": "string", "format": "uri", "title": "License URL" } } },

              "rights": { "type": "string", "title": "Rights" },

              "fundings": { "type": "array", "title": "Fundings",

                "items": { "type": "object", "required": ["name"], "properties": {

                  "name": { "type": "string", "title": "Award Identifier" },

                  "data": { "type": "string", "title": "Funder Name" } } } },

              "description": { "type": ["string", "null"], "title": "Description" },

              "relatedItems": { "type": "array", "title": "Related Items",

                "items": { "type": "object", "properties": {

                  "name": { "type": "string", "title": "Item Type" },

                  "data": { "type": "string", "format": "uri", "title": "Item Identifier" } } } },

              "rawMetadata": { "type": "string", "title": "Raw Metadata" },

              "rawFormat": { "type": "string", "title": "Metadata Format" },

              "rawChecksum": { "type": ["string", "null"], "title": "Metadata Checksum (MD5)" } },

              "patternProperties": {

                "@.*": { "type": "array", "title": "Relation Type",

                          "items": { "type": "object", "required": ["name", "data"], "properties": {

                            "name": { "type": "string", "title": "Relation Title" },

                            "data": { "type": "string", "format": "uri", "title": "Related Record Identifier" } } } } } } } },

      { "type": "object", "title": "Fetch Result (DataCite)", "required": ["type", "id", "attributes"], "properties": {

          "type": { "type": "string", "const": "data" },

          "id": { "type": "string", "description": "Record Identifier", "pattern": "^ni:.*" },

          "attributes": { "type": "object", "title": "Payload", "required": ["doi", "titles", "creators",
                                                                             "publisher", "publicationYear", "types"], "properties": {

            "doi": { "type": "string", "title": "DOI" },

            "creators": { "type": "array", "title": "Creators",

              "items": { "type": "object", "properties": {

                "name": { "type": "string" } } } },

            "titles": { "type": "array", "title": "Titles",

              "items": { "type": "object", "properties": {

                "title": { "type": "string", "title": "Title" },

                "titleType": { "type": "string", "title": "Title Type" } } } },

            "publisher": { "type": "object", "properties": {

              "name": { "type": "string", "title": "Publisher Name" } } },

            "publicationYear": { "type": "string", "title": "Publication Year" },

            "subjects": { "type": "array", "title": "Subjects",

              "items": { "type": "object", "properties": {

                "subject": { "type": "string", "title": "Subject" } } } },

            "language": { "type": "string", "title": "Language" },

            "types": { "type": "object", "properties": {

              "resourceType": { "type": "string", "title": "Resource Type" } } },

            "alternateIdentifiers": { "type": "array", "title": "Alternate Identifiers",

            "items": { "type": "object", "properties": {

              "alternateIdentifier": { "type": "string", "title": "Alternative Identifier" },

              "alternateIdentifierType": { "type": "string", "title": "Alternative Identifier Type" } } } },

            "sizes": { "type": "array", "title": "Sizes",

              "items": { "type": "string", "title": "Size" } },

            "formats": { "type": "array", "title": "Formats",

              "items": { "type": "string", "title": "Format" } },

            "version": { "type": "string", "title": "Version" },

            "rightsList": { "type": "array", "title": "Rights List",

              "items": { "type": "object", "properties": {

                "rights": { "type": "string", "title": "Rights" },

                "rightsUri": { "type": "string", "title": "Rights URI" } } } },

            "descriptions": { "type": "array", "title": "Descriptions",

              "items": { "type": "object", "properties": {

                "description": { "type": "string", "title": "Description" } } } },

            "fundingReferences": { "type": "array", "title": "Funding References",

              "items": { "type": "object", "properties": {

                "awardNumber": { "type": "string", "title": "Award Number" },

                "funderName": { "type": "string", "title": "Funder Name" } } } } } } } },

      { "type": "object", "title": "Fetch Result (BibJSON)", "required": ["type", "id", "attributes"], "properties": {

          "type": { "type": "string", "const": "data" },

          "id": { "type": "string", "description": "Record Identifier", "pattern": "^ni:.*" },

          "attributes": { "type": "object", "title": "Payload", "required": ["cid", "author", "title", "year"], "properties": {

              "cid": { "type": "string", "title": "Collection Identifier" },

              "author": { "type": "array", "title": "Authors",

                "items": { "type": "object", "required": ["name"], "properties": {

                  "name": { "type": "string", "title": "Author Name" } } } },

              "title": { "type": "string", "title": "Title" },

              "year": { "type": ["string", "null"], "title": "Published" },

              "identifier": { "type": "array", "title": "Identifiers",

                "items": { "type": "object", "properties": {

                  "type": { "type": "string", "title": "Identifier Type" },

                  "id": { "type": "string", "title": "Identifier" } } } },

              "link": { "type": "array", "title": "Links",

                "items": { "type": "object", "properties": {

                  "url": { "type": "string", "title": "Link" } } } },

              "entrytype": { "type": "string", "title": "Type" },

              "publisher": { "type": "string", "title": "Publisher" } } } } } ] },

    "errors": { "type": "array", "description": "See: https://jsonapi.org/format/#document-top-level", "minItems": 1,

      "items": { "type": "object", "description": "See: https://jsonapi.org/format/#error-objects", "required": ["title", "detail"], "properties": {

        "title": { "type": "string" },

        "detail": { "type": "string" },

        "links": { "type": "object",

          "additionalProperties": { "type": "string", "format": "uri" } } } } },

    "meta": { "type": "object", "description": "See: https://jsonapi.org/format/#document-meta", "required": ["name", "version"], "properties": {

      "name": { "type": "string", "const": "DatAasee" },

      "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" } } },

    "links": { "type": "object", "description": "See: https://jsonapi.org/format/#document-links", "required": ["self", "describedby"], "properties": {

      "self": { "type": "string", "format": "uri" },

      "describedby": { "type": "string", "format": "uri" },

      "first": { "type": "string", "format": "uri" },

      "prev": { "type": "string", "format": "uri" },

      "next": { "type": "string", "format": "uri" } } } }
}
